{
  "schemaVersion": "1.0",
  "id": "meridian.look_up_a_member_by_their_member_id_and_",
  "name": "Look up a member by their member ID and read their savings balance",
  "description": "Look up a member by their member ID and read their savings balance",
  "target": {
