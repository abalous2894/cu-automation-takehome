    "status": {
      "type": "string",
      "description": "Extracted: status",
      "sensitive": false,
      "extract": {
        "pattern": "Status:[ \\t]+([^\\n\\t]+)"
      }
    },
    "savingsBalance": {
      "type": "string",
      "description": "Extracted: savingsBalance",
      "sensitive": false,
      "extract": {
        "pattern": "Savings[ \\t]+([^\\n\\t]+)"
      }
    },
    "checkingBalance": {
      "type": "string",
      "description": "Extracted: checkingBalance",
      "sensitive": false,
      "extract": {
        "pattern": "Checking[ \\t]+([^\\n\\t]+)"
      }
    }
  },
  "steps": [
    {
      "id": "step_1",
