      "target": {
        "strategies": [
          {
            "type": "role",
            "role": "button",
            "name": "Search",
            "value": "Search",
            "match": "exact"
          }
        ]
      },
      "riskLevel": "safe",
      "timeoutMs": 10000,
      "optional": false
